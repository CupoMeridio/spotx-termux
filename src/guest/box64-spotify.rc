# Box64 settings for Spotify: the single source of truth. Installed by guest-setup.sh
# as /root/.box64rc, merged into /etc/box64.box64rc, and copied to
# /usr/local/lib/spotx-termux/box64-spotify.rc, from which spotify-box64-wrapper.sh
# exports every BOX64_* line at launch.
# BOX64_INPROCESSGPU must stay 0: --in-process-gpu crashes Spotify's zygote process.
[spotify]
BOX64_NOBANNER=1
BOX64_LOG=0
BOX64_DYNAREC=1
BOX64_NOSANDBOX=1
BOX64_INPROCESSGPU=0
BOX64_MALLOC_HACK=2
BOX64_DYNAREC_STRONGMEM=1
BOX64_DYNAREC_BIGBLOCK=1
BOX64_DYNAREC_FASTNAN=1
BOX64_DYNAREC_FASTROUND=1
BOX64_DYNAREC_SAFEFLAGS=1
